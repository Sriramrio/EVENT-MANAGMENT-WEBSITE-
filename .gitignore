# ==========================================
# Root .gitignore for MSME Stall Booking Project
# ==========================================

# ------------------------------------------
# Large Files & Archives
# ------------------------------------------
*.zip
*.tar.gz
*.rar
*.7z
MSME*.zip

# ------------------------------------------
# Node / Frontend
# ------------------------------------------
node_modules/
Frontend/node_modules/
dist/
Frontend/dist/
build/
Frontend/build/
.npm
*.tsbuildinfo
Frontend/*.tsbuildinfo

# Env files (Keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
Frontend/.env
Frontend/.env.local

# Frontend Test & E2E Output
Frontend/test-results/
Frontend/playwright-report/
Frontend/blob-report/
Frontend/playwright/.cache/

# ------------------------------------------
# .NET / C# / Backend
# ------------------------------------------
bin/
Backend/**/bin/
obj/
Backend/**/obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild/
[Bb]in/
[Oo]bj/

# Visual Studio / Rider / IDE
.vs/
Backend/.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
.idea/
.vscode/
*.swp
*.*~

# Backend Secrets & Config
Backend/src/**/appsettings.Development.json
Backend/src/**/appsettings.Local.json

# ------------------------------------------
# OS Generated Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
